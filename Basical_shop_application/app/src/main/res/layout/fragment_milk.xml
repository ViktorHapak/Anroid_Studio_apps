<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.MilkFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/milk1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Trappista_sajt 450" />

            <Button
                android:id="@+id/milk2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Tej(1,5%) 460" />

            <Button
                android:id="@+id/milk3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Túró 900" />

            <Button
                android:id="@+id/milk4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Kemény_sajt 250" />

            <Button
                android:id="@+id/milk5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Krémtúró 330" />

            <Button
                android:id="@+id/milk6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Vaj 550" />

            <Button
                android:id="@+id/milk7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Krémsajt 330" />

            <Button
                android:id="@+id/milk8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Joghurt 280" />

            <Button
                android:id="@+id/milk9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="addProduct"
                android:text="Mascarpone 900" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>